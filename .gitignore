# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Widget Preview related
.widget_preview/

# ---------------------------------------------------------------------------
# Local data, artifacts and secrets (open-source hygiene)
# ---------------------------------------------------------------------------

# Local databases / caches (never commit user or generated data)
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
/zh-cn.sqlite
# ...but the bundled offline dictionary must ship with the launcher.
!assets/data/zh-cn.sqlite

# Jars downloaded to the project root; the bundled agent stays tracked
/*.jar
!assets/lib/*.jar
/neoforge-*.jar
/neoforge-*.jar.log

# Secrets / environment files
.env
.env.*
*.pem
*.key
*.p12
*.jks
*.keystore

# Launcher runtime folders if they are ever created inside the repo
/logs/
/cache/
/runtime/

# Root-level scratch output from tests / CLI tools
/*.txt
!/LICENSE.txt
